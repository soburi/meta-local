@@ -654,6 +696,7 @@ static int virtio_mmio_probe(struct platform_device *pdev)
 	}
 
 	vm_dev->vdev.id.device = readl(vm_dev->base + VIRTIO_MMIO_DEVICE_ID);
+	pr_err("vm_dev->vdev.id.device %llx", vm_dev->vdev.id.device);
 	if (vm_dev->vdev.id.device == 0) {
 		/*
 		 * virtio-mmio device with an ID 0 is a (dummy) placeholder
@@ -689,6 +732,8 @@ static int virtio_mmio_probe(struct platform_device *pdev)
 	if (rc)
 		put_device(&vm_dev->vdev.dev);
 
+	pr_err("end virtio_mmio_probe: %d\n", rc);
+
 	return rc;
 
 free_vm_dev:
