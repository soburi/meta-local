@@ -1702,6 +1712,8 @@ int xen_evtchn_do_upcall(void)
 	int cpu = smp_processor_id();
 	struct evtchn_loop_ctrl ctrl = { 0 };
 
+	//pr_err("xen_evtchn_do_upcall");
+
 	/*
 	 * When closing an event channel the associated IRQ must not be freed
 	 * until all cpus have left the event handling loop. This is ensured
diff --git a/drivers/xen/events/events_fifo.c b/drivers/xen/events/events_fifo.c
index 655775db7caf..14c9c83a728c 100644
--- a/drivers/xen/events/events_fifo.c
+++ b/drivers/xen/events/events_fifo.c
@@ -279,6 +279,8 @@ static void consume_one_event(unsigned cpu, struct evtchn_loop_ctrl *ctrl,
 	evtchn_port_t port;
 	event_word_t *word;
 
+	//pr_err("consume_one_event");
+
