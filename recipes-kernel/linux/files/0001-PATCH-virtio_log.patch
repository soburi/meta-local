+void virtqueue_set_desc_flag_marker(const struct virtqueue *_vq)
+{
+        const struct vring_virtqueue *vq = to_vvq(_vq);
+
+        if (vq->packed_ring)
+		vq->packed.vring.desc->flags = 0xF800;
+	else
+		vq->split.vring.desc->flags = 0xF800;
+}
