 	features <<= 32;
@@ -118,6 +120,8 @@ static u64 vm_get_features(struct virtio_device *vdev)
 	writel(0, vm_dev->base + VIRTIO_MMIO_DEVICE_FEATURES_SEL);
 	features |= readl(vm_dev->base + VIRTIO_MMIO_DEVICE_FEATURES);
 
+	pr_err("vm_get_features %llx\n", features);
+
 	return features;
 }
 
@@ -128,12 +132,15 @@ static int vm_finalize_features(struct virtio_device *vdev)
 	/* Give virtio_ring a chance to accept features. */
 	vring_transport_features(vdev);
 
+#if 1
 	/* Make sure there are no mixed devices */
+        pr_err("%s %llx %llx", __func__, vdev->features, BIT_ULL(VIRTIO_F_VERSION_1));
 	if (vm_dev->version == 2 &&
 			!__virtio_test_bit(vdev, VIRTIO_F_VERSION_1)) {
 		dev_err(&vdev->dev, "New virtio-mmio devices (version 2) must provide VIRTIO_F_VERSION_1 feature!\n");
 		return -EINVAL;
 	}
+#endif
 
 	writel(1, vm_dev->base + VIRTIO_MMIO_DRIVER_FEATURES_SEL);
 	writel((u32)(vdev->features >> 32),
@@ -155,6 +162,8 @@ static void vm_get(struct virtio_device *vdev, unsigned int offset,
 	__le16 w;
 	__le32 l;
 
+	pr_err("%s\n", __func__);
+
 	if (vm_dev->version == 1) {
 		u8 *ptr = buf;
 		int i;
@@ -235,6 +244,7 @@ static u32 vm_generation(struct virtio_device *vdev)
 {
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 
+	pr_err("%s\n", __func__);
 	if (vm_dev->version == 1)
 		return 0;
 	else
@@ -245,6 +255,7 @@ static u8 vm_get_status(struct virtio_device *vdev)
 {
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 
+	pr_err("%s\n", __func__);
 	return readl(vm_dev->base + VIRTIO_MMIO_STATUS) & 0xff;
 }
 
@@ -268,6 +279,7 @@ static void vm_reset(struct virtio_device *vdev)
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 
 	/* 0 status means a reset. */
+	pr_err("%s", __func__);
 	writel(0, vm_dev->base + VIRTIO_MMIO_STATUS);
 }
 
@@ -305,6 +317,8 @@ static irqreturn_t vm_interrupt(int irq, void *opaque)
 	unsigned long flags;
 	irqreturn_t ret = IRQ_NONE;
 
+	pr_err("vm_interrupt %d\n", irq);
+
 	/* Read and acknowledge interrupts */
 	status = readl(vm_dev->base + VIRTIO_MMIO_INTERRUPT_STATUS);
 	writel(status, vm_dev->base + VIRTIO_MMIO_INTERRUPT_ACK);
@@ -333,6 +347,7 @@ static void vm_del_vq(struct virtqueue *vq)
 	unsigned long flags;
 	unsigned int index = vq->index;
 
+	pr_err("%s\n", __func__);
 	spin_lock_irqsave(&vm_dev->lock, flags);
 	list_del(&info->node);
 	spin_unlock_irqrestore(&vm_dev->lock, flags);
@@ -369,6 +384,9 @@ static void vm_synchronize_cbs(struct virtio_device *vdev)
 	synchronize_irq(platform_get_irq(vm_dev->pdev, 0));
 }
 
+
+void virtqueue_set_desc_flag_marker(const struct virtqueue *_vq);
+
 static struct virtqueue *vm_setup_vq(struct virtio_device *vdev, unsigned int index,
 				  void (*callback)(struct virtqueue *vq),
 				  const char *name, bool ctx)
@@ -381,6 +399,8 @@ static struct virtqueue *vm_setup_vq(struct virtio_device *vdev, unsigned int in
 	unsigned int num;
 	int err;
 
+	pr_err("%s %s\n", __func__, name);
+
 	if (__virtio_test_bit(vdev, VIRTIO_F_NOTIFICATION_DATA))
 		notify = vm_notify_with_data;
 	else
@@ -395,6 +415,7 @@ static struct virtqueue *vm_setup_vq(struct virtio_device *vdev, unsigned int in
 	/* Queue shouldn't already be set up. */
 	if (readl(vm_dev->base + (vm_dev->version == 1 ?
 			VIRTIO_MMIO_QUEUE_PFN : VIRTIO_MMIO_QUEUE_READY))) {
+		pr_err("%s QUEUE_READY not ready\n", __func__);
 		err = -ENOENT;
 		goto error_available;
 	}
@@ -407,6 +428,7 @@ static struct virtqueue *vm_setup_vq(struct virtio_device *vdev, unsigned int in
 	}
 
 	num = readl(vm_dev->base + VIRTIO_MMIO_QUEUE_NUM_MAX);
+	pr_err("%s QUEUE_NUM_MAX %d\n", __func__, num);
 	if (num == 0) {
 		err = -ENOENT;
 		goto error_new_virtqueue;
@@ -415,6 +437,7 @@ static struct virtqueue *vm_setup_vq(struct virtio_device *vdev, unsigned int in
 	/* Create the vring */
 	vq = vring_create_virtqueue(index, num, VIRTIO_MMIO_VRING_ALIGN, vdev,
 				 true, true, ctx, notify, callback, name);
+	pr_err("%s vring_create_virtqueue %p\n", __func__, vq);
 	if (!vq) {
 		err = -ENOMEM;
 		goto error_new_virtqueue;
@@ -445,18 +468,26 @@ static struct virtqueue *vm_setup_vq(struct virtio_device *vdev, unsigned int in
 	} else {
 		u64 addr;
 
+		virtqueue_set_desc_flag_marker(vq);
+
 		addr = virtqueue_get_desc_addr(vq);
+		pr_err("%s QUEUE_DESC_LOW %lx\n", __func__, addr);
 		writel((u32)addr, vm_dev->base + VIRTIO_MMIO_QUEUE_DESC_LOW);
+		pr_err("%s QUEUE_DESC_HIGH %lx\n", __func__, addr>>32);
 		writel((u32)(addr >> 32),
 				vm_dev->base + VIRTIO_MMIO_QUEUE_DESC_HIGH);
 
 		addr = virtqueue_get_avail_addr(vq);
+		pr_err("%s QUEUE_AVAIL_LOW %lx\n", __func__, addr);
 		writel((u32)addr, vm_dev->base + VIRTIO_MMIO_QUEUE_AVAIL_LOW);
+		pr_err("%s QUEUE_AVAIL_HIGH %lx\n", __func__, addr>>32);
 		writel((u32)(addr >> 32),
 				vm_dev->base + VIRTIO_MMIO_QUEUE_AVAIL_HIGH);
 
 		addr = virtqueue_get_used_addr(vq);
+		pr_err("%s QUEUE_USED_LOW %lx\n", __func__, addr);
 		writel((u32)addr, vm_dev->base + VIRTIO_MMIO_QUEUE_USED_LOW);
+		pr_err("%s QUEUE_USED_HIGH %lx\n", __func__, addr>>32);
 		writel((u32)(addr >> 32),
 				vm_dev->base + VIRTIO_MMIO_QUEUE_USED_HIGH);
 
@@ -484,6 +515,7 @@ static struct virtqueue *vm_setup_vq(struct virtio_device *vdev, unsigned int in
 	kfree(info);
 error_kmalloc:
 error_available:
+	pr_err("%s err %d\n", __func__, err);
 	return ERR_PTR(err);
 }
 
@@ -496,14 +528,20 @@ static int vm_find_vqs(struct virtio_device *vdev, unsigned int nvqs,
 	int irq = platform_get_irq(vm_dev->pdev, 0);
 	int i, err, queue_idx = 0;
 
+	pr_err("%s\n", __func__);
+
 	if (irq < 0)
 		return irq;
 
+	pr_err("irq %d\n", irq);
+
 	err = request_irq(irq, vm_interrupt, IRQF_SHARED,
 			dev_name(&vdev->dev), vm_dev);
 	if (err)
 		return err;
 
