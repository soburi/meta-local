 	if (of_property_read_bool(vm_dev->pdev->dev.of_node, "wakeup-source"))
 		enable_irq_wake(irq);
 
@@ -539,6 +577,7 @@ static bool vm_get_shm_region(struct virtio_device *vdev,
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 	u64 len, addr;
 
+	pr_err("%s\n", __func__);
 	/* Select the region we're interested in */
 	writel(id, vm_dev->base + VIRTIO_MMIO_SHM_SEL);
 
@@ -619,6 +658,8 @@ static int virtio_mmio_probe(struct platform_device *pdev)
 	unsigned long magic;
 	int rc;
 
+	pr_err("virtio_mmio_probe\n");
+
 	vm_dev = kzalloc(sizeof(*vm_dev), GFP_KERNEL);
 	if (!vm_dev)
 		return -ENOMEM;
@@ -646,6 +687,7 @@ static int virtio_mmio_probe(struct platform_device *pdev)
 
 	/* Check device version */
