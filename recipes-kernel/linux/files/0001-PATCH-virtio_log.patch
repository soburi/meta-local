diff --git a/arch/arm/xen/enlighten.c b/arch/arm/xen/enlighten.c
index a395b6c0aae2..b7ec5eae95f3 100644
--- a/arch/arm/xen/enlighten.c
+++ b/arch/arm/xen/enlighten.c
@@ -204,6 +204,7 @@ static void xen_power_off(void)
 
 static irqreturn_t xen_arm_callback(int irq, void *arg)
 {
+	//pr_err("xen_arm_callback %d", irq);
 	xen_evtchn_do_upcall();
 	return IRQ_HANDLED;
 }
diff --git a/drivers/char/hw_random/virtio-rng.c b/drivers/char/hw_random/virtio-rng.c
index dd998f4fe4f2..e3440a63a72a 100644
--- a/drivers/char/hw_random/virtio-rng.c
+++ b/drivers/char/hw_random/virtio-rng.c
@@ -52,15 +52,21 @@ static void request_entropy(struct virtrng_info *vi)
 {
 	struct scatterlist sg;
 
+	printk("%s", __func__);
+
 	reinit_completion(&vi->have_data);
+	printk("%s: reinit_completion", __func__);
 	vi->data_idx = 0;
 
 	sg_init_one(&sg, vi->data, sizeof(vi->data));
+	printk("%s: sg_init_one", __func__);
 
 	/* There should always be room for one buffer. */
 	virtqueue_add_inbuf(vi->vq, &sg, 1, vi->data, GFP_KERNEL);
+	printk("%s: virtqueue_add_inbuf", __func__);
 
 	virtqueue_kick(vi->vq);
+	printk("%s: virtqueue_kick", __func__);
 }
 
 static unsigned int copy_data(struct virtrng_info *vi, void *buf,
@@ -82,6 +88,8 @@ static int virtio_read(struct hwrng *rng, void *buf, size_t size, bool wait)
 	unsigned int chunk;
 	size_t read;
 
+	pr_err("%s %d %d %d", __func__, size, wait, vi->hwrng_removed);
+
 	if (vi->hwrng_removed)
 		return -ENODEV;
 
@@ -97,25 +105,43 @@ static int virtio_read(struct hwrng *rng, void *buf, size_t size, bool wait)
 	if (!wait)
 		return read;
 
+	pr_err("%s while", __func__, size);
+
 	/* We have already copied available entropy,
 	 * so either size is 0 or data_avail is 0
 	 */
 	while (size != 0) {
 		/* data_avail is 0 but a request is pending */
+		pr_err("%s wait_for_completion_killable", __func__);
 		ret = wait_for_completion_killable(&vi->have_data);
+		pr_err("%s wait_for_completion_killable end", __func__);
 		if (ret < 0)
 			return ret;
 		/* if vi->data_avail is 0, we have been interrupted
 		 * by a cleanup, but buffer stays in the queue
 		 */
-		if (vi->data_avail == 0)
+		if (vi->data_avail == 0) {
+			pr_err("%s end %d", __func__, read);
 			return read;
+		}
 
 		chunk = copy_data(vi, buf + read, size);
+		uint8_t *ptr = buf + read;
+		for(int i=0; i<read; i++) {
+			pr_err("%02x ", ptr[i]);
+			if ((i % 8) == 0) {
+				pr_err("\n");
+			}
+
+			
+		}
+
 		size -= chunk;
 		read += chunk;
 	}
 
+	pr_err("%s end2 %d", __func__, read);
+
 	return read;
 }
 
@@ -131,6 +157,8 @@ static int probe_common(struct virtio_device *vdev)
 	int err, index;
 	struct virtrng_info *vi = NULL;
 
+	pr_err("virtio-rng: probe_common");
+
 	vi = kzalloc(sizeof(struct virtrng_info), GFP_KERNEL);
 	if (!vi)
 		return -ENOMEM;
@@ -153,15 +181,21 @@ static int probe_common(struct virtio_device *vdev)
 
 	/* We expect a single virtqueue. */
 	vi->vq = virtio_find_single_vq(vdev, random_recv_done, "input");
+#if 1
 	if (IS_ERR(vi->vq)) {
 		err = PTR_ERR(vi->vq);
 		goto err_find;
 	}
+#endif
 
 	virtio_device_ready(vdev);
 
 	/* we always have a pending entropy request */
+#if 1
 	request_entropy(vi);
+#endif
+
+	pr_err("virtio-rng: probe_common end: 0");
 
 	return 0;
 
@@ -169,6 +203,7 @@ static int probe_common(struct virtio_device *vdev)
 	ida_free(&rng_index_ida, index);
 err_ida:
 	kfree(vi);
+	pr_err("probe_common err %d", err);
 	return err;
 }
 
diff --git a/drivers/virtio/virtio.c b/drivers/virtio/virtio.c
index b9095751e43b..0f6211e339e0 100644
--- a/drivers/virtio/virtio.c
+++ b/drivers/virtio/virtio.c
@@ -74,6 +74,7 @@ ATTRIBUTE_GROUPS(virtio_dev);
 static inline int virtio_id_match(const struct virtio_device *dev,
 				  const struct virtio_device_id *id)
 {
+	pr_err("%s: %d - %d", id->device, dev->id.device);
 	if (id->device != dev->id.device && id->device != VIRTIO_DEV_ANY_ID)
 		return 0;
 
@@ -207,13 +208,16 @@ static int virtio_features_ok(struct virtio_device *dev)
 
 	might_sleep();
 
+#if 1
 	if (virtio_check_mem_acc_cb(dev)) {
+		pr_err("%s %llx %llx", __func__, dev->features, BIT_ULL(VIRTIO_F_VERSION_1));
 		if (!virtio_has_feature(dev, VIRTIO_F_VERSION_1)) {
 			dev_warn(&dev->dev,
 				 "device must provide VIRTIO_F_VERSION_1\n");
 			return -ENODEV;
 		}
 
+		pr_err("%s %llx %llx", __func__, dev->features, BIT_ULL(VIRTIO_F_ACCESS_PLATFORM));
 		if (!virtio_has_feature(dev, VIRTIO_F_ACCESS_PLATFORM)) {
 			dev_warn(&dev->dev,
 				 "device must provide VIRTIO_F_ACCESS_PLATFORM\n");
@@ -223,13 +227,16 @@ static int virtio_features_ok(struct virtio_device *dev)
 
 	if (!virtio_has_feature(dev, VIRTIO_F_VERSION_1))
 		return 0;
+#endif
 
 	virtio_add_status(dev, VIRTIO_CONFIG_S_FEATURES_OK);
 	status = dev->config->get_status(dev);
 	if (!(status & VIRTIO_CONFIG_S_FEATURES_OK)) {
 		dev_err(&dev->dev, "virtio: device refuses features: %x\n",
 			status);
+#if 1
 		return -ENODEV;
+#endif
 	}
 	return 0;
 }
@@ -276,6 +283,8 @@ static int virtio_dev_probe(struct device *_d)
 	u64 driver_features;
 	u64 driver_features_legacy;
 
+	pr_err("%s", __func__);
+
 	/* We have a driver! */
 	virtio_add_status(dev, VIRTIO_CONFIG_S_DRIVER);
 
@@ -316,6 +325,7 @@ static int virtio_dev_probe(struct device *_d)
 			__virtio_set_bit(dev, i);
 
 	err = dev->config->finalize_features(dev);
+	pr_err("%s finalize_features %d", __func__, err);
 	if (err)
 		goto err;
 
@@ -323,22 +333,26 @@ static int virtio_dev_probe(struct device *_d)
 		u64 features = dev->features;
 
 		err = drv->validate(dev);
+		pr_err("%s validate %d", __func__, err);
 		if (err)
 			goto err;
 
 		/* Did validation change any features? Then write them again. */
 		if (features != dev->features) {
 			err = dev->config->finalize_features(dev);
+			pr_err("%s finalize_features2 %d", __func__, err);
 			if (err)
 				goto err;
 		}
 	}
 
 	err = virtio_features_ok(dev);
+	pr_err("%s virtio_features_ok %d", __func__, err);
 	if (err)
 		goto err;
 
 	err = drv->probe(dev);
+	pr_err("%s probe %d", __func__, err);
 	if (err)
 		goto err;
 
@@ -393,7 +407,11 @@ int __register_virtio_driver(struct virtio_driver *driver, struct module *owner)
 	driver->driver.bus = &virtio_bus;
 	driver->driver.owner = owner;
 
-	return driver_register(&driver->driver);
+	int ret = driver_register(&driver->driver);
+
+	pr_err("%s: %d\n", __func__, ret);
+
+	return ret;
 }
 EXPORT_SYMBOL_GPL(__register_virtio_driver);
 
diff --git a/drivers/virtio/virtio_mmio.c b/drivers/virtio/virtio_mmio.c
