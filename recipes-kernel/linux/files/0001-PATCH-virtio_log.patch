diff --git a/drivers/virtio/virtio.c b/drivers/virtio/virtio.c
index b9095751e43b..1fad40dfd661 100644
--- a/drivers/virtio/virtio.c
+++ b/drivers/virtio/virtio.c
@@ -207,13 +207,16 @@ static int virtio_features_ok(struct virtio_device *dev)
 
 	might_sleep();
 
+#if 1
 	if (virtio_check_mem_acc_cb(dev)) {
+		pr_err("%s %llx %llx", __func__, dev->features, BIT_ULL(VIRTIO_F_VERSION_1));
 		if (!virtio_has_feature(dev, VIRTIO_F_VERSION_1)) {
 			dev_warn(&dev->dev,
 				 "device must provide VIRTIO_F_VERSION_1\n");
 			return -ENODEV;
 		}
 
+		pr_err("%s %llx %llx", __func__, dev->features, BIT_ULL(VIRTIO_F_ACCESS_PLATFORM));
 		if (!virtio_has_feature(dev, VIRTIO_F_ACCESS_PLATFORM)) {
 			dev_warn(&dev->dev,
 				 "device must provide VIRTIO_F_ACCESS_PLATFORM\n");
@@ -223,13 +226,16 @@ static int virtio_features_ok(struct virtio_device *dev)
 
 	if (!virtio_has_feature(dev, VIRTIO_F_VERSION_1))
 		return 0;
+#endif
 
 	virtio_add_status(dev, VIRTIO_CONFIG_S_FEATURES_OK);
 	status = dev->config->get_status(dev);
 	if (!(status & VIRTIO_CONFIG_S_FEATURES_OK)) {
 		dev_err(&dev->dev, "virtio: device refuses features: %x\n",
 			status);
+#if 1
 		return -ENODEV;
+#endif
 	}
 	return 0;
 }
diff --git a/drivers/virtio/virtio_mmio.c b/drivers/virtio/virtio_mmio.c
index 90e784e7b721..6a15e555784c 100644
--- a/drivers/virtio/virtio_mmio.c
+++ b/drivers/virtio/virtio_mmio.c
@@ -111,6 +111,8 @@ static u64 vm_get_features(struct virtio_device *vdev)
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 	u64 features;
 
+	pr_err("vm_get_features\n");
+
 	writel(1, vm_dev->base + VIRTIO_MMIO_DEVICE_FEATURES_SEL);
 	features = readl(vm_dev->base + VIRTIO_MMIO_DEVICE_FEATURES);
 	features <<= 32;
@@ -118,6 +120,8 @@ static u64 vm_get_features(struct virtio_device *vdev)
 	writel(0, vm_dev->base + VIRTIO_MMIO_DEVICE_FEATURES_SEL);
 	features |= readl(vm_dev->base + VIRTIO_MMIO_DEVICE_FEATURES);
 
+	pr_err("vm_get_features %llx\n", features);
+
 	return features;
 }
 
@@ -128,12 +132,15 @@ static int vm_finalize_features(struct virtio_device *vdev)
 	/* Give virtio_ring a chance to accept features. */
 	vring_transport_features(vdev);
 
+#if 1
 	/* Make sure there are no mixed devices */
+        pr_err("%s %llx %llx", __func__, vdev->features, BIT_ULL(VIRTIO_F_VERSION_1));
 	if (vm_dev->version == 2 &&
 			!__virtio_test_bit(vdev, VIRTIO_F_VERSION_1)) {
 		dev_err(&vdev->dev, "New virtio-mmio devices (version 2) must provide VIRTIO_F_VERSION_1 feature!\n");
 		return -EINVAL;
 	}
+#endif
 
 	writel(1, vm_dev->base + VIRTIO_MMIO_DRIVER_FEATURES_SEL);
 	writel((u32)(vdev->features >> 32),
@@ -155,6 +162,8 @@ static void vm_get(struct virtio_device *vdev, unsigned int offset,
 	__le16 w;
 	__le32 l;
 
+	pr_err("%s\n", __func__);
+
 	if (vm_dev->version == 1) {
 		u8 *ptr = buf;
 		int i;
@@ -235,6 +244,7 @@ static u32 vm_generation(struct virtio_device *vdev)
 {
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 
+	pr_err("%s\n", __func__);
 	if (vm_dev->version == 1)
 		return 0;
 	else
@@ -245,6 +255,7 @@ static u8 vm_get_status(struct virtio_device *vdev)
 {
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 
+	pr_err("%s\n", __func__);
 	return readl(vm_dev->base + VIRTIO_MMIO_STATUS) & 0xff;
 }
 
@@ -268,6 +279,7 @@ static void vm_reset(struct virtio_device *vdev)
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 
 	/* 0 status means a reset. */
+	pr_err("%s", __func__);
 	writel(0, vm_dev->base + VIRTIO_MMIO_STATUS);
 }
 
@@ -305,6 +317,8 @@ static irqreturn_t vm_interrupt(int irq, void *opaque)
 	unsigned long flags;
 	irqreturn_t ret = IRQ_NONE;
 
+	pr_err("vm_interrupt %d\n", irq);
+
 	/* Read and acknowledge interrupts */
 	status = readl(vm_dev->base + VIRTIO_MMIO_INTERRUPT_STATUS);
 	writel(status, vm_dev->base + VIRTIO_MMIO_INTERRUPT_ACK);
@@ -333,6 +347,7 @@ static void vm_del_vq(struct virtqueue *vq)
 	unsigned long flags;
 	unsigned int index = vq->index;
 
+	pr_err("%s\n", __func__);
 	spin_lock_irqsave(&vm_dev->lock, flags);
 	list_del(&info->node);
 	spin_unlock_irqrestore(&vm_dev->lock, flags);
@@ -381,6 +396,8 @@ static struct virtqueue *vm_setup_vq(struct virtio_device *vdev, unsigned int in
 	unsigned int num;
 	int err;
 
+	pr_err("%s\n", __func__);
+
 	if (__virtio_test_bit(vdev, VIRTIO_F_NOTIFICATION_DATA))
 		notify = vm_notify_with_data;
 	else
@@ -496,14 +513,20 @@ static int vm_find_vqs(struct virtio_device *vdev, unsigned int nvqs,
 	int irq = platform_get_irq(vm_dev->pdev, 0);
 	int i, err, queue_idx = 0;
 
+	pr_err("%s\n", __func__);
+
 	if (irq < 0)
 		return irq;
 
+	pr_err("irq %d\n", irq);
+
 	err = request_irq(irq, vm_interrupt, IRQF_SHARED,
 			dev_name(&vdev->dev), vm_dev);
 	if (err)
 		return err;
 
+	pr_err("request_irq %d\n", err);
+
 	if (of_property_read_bool(vm_dev->pdev->dev.of_node, "wakeup-source"))
 		enable_irq_wake(irq);
 
@@ -539,6 +562,7 @@ static bool vm_get_shm_region(struct virtio_device *vdev,
 	struct virtio_mmio_device *vm_dev = to_virtio_mmio_device(vdev);
 	u64 len, addr;
 
+	pr_err("%s\n", __func__);
 	/* Select the region we're interested in */
 	writel(id, vm_dev->base + VIRTIO_MMIO_SHM_SEL);
 
@@ -619,6 +643,8 @@ static int virtio_mmio_probe(struct platform_device *pdev)
 	unsigned long magic;
 	int rc;
 
+	pr_err("virtio_mmio_probe\n");
+
 	vm_dev = kzalloc(sizeof(*vm_dev), GFP_KERNEL);
 	if (!vm_dev)
 		return -ENOMEM;
@@ -689,6 +715,8 @@ static int virtio_mmio_probe(struct platform_device *pdev)
 	if (rc)
 		put_device(&vm_dev->vdev.dev);
 
+	pr_err("end virtio_mmio_probe: %d\n", rc);
+
 	return rc;
 
 free_vm_dev:
