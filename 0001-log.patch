Date: Tue, 13 May 2025 23:07:00 +0900
Subject: [PATCH] log

Upstream-Status: Submitted [tokita.hiroshi@gmail.com]
---
 xen/arch/arm/dm.c  |  2 ++
 xen/common/ioreq.c | 32 +++++++++++++++++++++++++-------
 2 files changed, 27 insertions(+), 7 deletions(-)

diff --git a/xen/arch/arm/dm.c b/xen/arch/arm/dm.c
index 8293bbf1cb..29eb4188d4 100644
--- a/xen/arch/arm/dm.c
+++ b/xen/arch/arm/dm.c
@@ -137,6 +137,8 @@ int dm_op(const struct dmop_args *op_args)
  out:
     rcu_unlock_domain(d);
 
+    printk("return %ld\n", rc);
+
     return rc;
 }
 
diff --git a/xen/common/ioreq.c b/xen/common/ioreq.c
index f5fd30ce12..8704f5c6f9 100644
--- a/xen/common/ioreq.c
+++ b/xen/common/ioreq.c
@@ -270,8 +270,10 @@ static int ioreq_server_alloc_mfn(struct ioreq_server *s, bool buf)
          * on demand if ioreq_server_get_info() is called), then
          * allocating a page is not permitted.
          */
-        if ( !gfn_eq(iorp->gfn, INVALID_GFN) )
+        if ( !gfn_eq(iorp->gfn, INVALID_GFN) ) {
+		printk("gfn_eq\n");
             return -EPERM;
+	}
 
         return 0;
     }
@@ -647,6 +649,8 @@ static int ioreq_server_create(struct domain *d, int bufioreq_handling,
     unsigned int i;
     int rc;
 
+    printk("ioreq_server_create\n");
+
     if ( !IS_ENABLED(CONFIG_X86) && bufioreq_handling )
         return -EINVAL;
 
@@ -679,6 +683,7 @@ static int ioreq_server_create(struct domain *d, int bufioreq_handling,
     rc = ioreq_server_init(s, d, bufioreq_handling, i);
     if ( rc )
     {
+	    printk("ioreq_server_init %d\n", rc);
         set_ioreq_server(d, i, NULL);
         goto fail;
     }
@@ -805,12 +810,16 @@ int ioreq_server_get_frame(struct domain *d, ioservid_t id,
         goto out;
 
     rc = -EPERM;
-    if ( s->emulator != current->domain )
+    if ( s->emulator != current->domain ) {
+	printk("s->emulator5\n");
         goto out;
+    }
 
     rc = ioreq_server_alloc_pages(s);
-    if ( rc )
+    if ( rc ) {
+	printk("rc\n");
         goto out;
+    }
 
     switch ( idx )
     {
@@ -859,8 +868,10 @@ static int ioreq_server_map_io_range(struct domain *d, ioservid_t id,
         goto out;
 
     rc = -EPERM;
-    if ( s->emulator != current->domain )
+    if ( s->emulator != current->domain ) {
+	printk("s->emulator4\n");
         goto out;
+    }
 
     switch ( type )
     {
@@ -911,8 +922,10 @@ static int ioreq_server_unmap_io_range(struct domain *d, ioservid_t id,
         goto out;
 
     rc = -EPERM;
-    if ( s->emulator != current->domain )
+    if ( s->emulator != current->domain ) {
+	printk("s->emulator3\n");
         goto out;
+    }
 
     switch ( type )
     {
@@ -972,8 +985,10 @@ int ioreq_server_map_mem_type(struct domain *d, ioservid_t id,
         goto out;
 
     rc = -EPERM;
-    if ( s->emulator != current->domain )
+    if ( s->emulator != current->domain ) {
+	printk("s->emulator2\n");
         goto out;
+    }
 
     rc = arch_ioreq_server_map_mem_type(d, s, flags);
 
@@ -1001,8 +1016,10 @@ static int ioreq_server_set_state(struct domain *d, ioservid_t id,
         goto out;
 
     rc = -EPERM;
-    if ( s->emulator != current->domain )
+    if ( s->emulator != current->domain ) {
+	printk("s->emulator\n");
         goto out;
+    }
 
     domain_pause(d);
 
@@ -1353,6 +1370,7 @@ int ioreq_server_dm_op(struct xen_dm_op *op, struct domain *d, bool *const_op)
         if ( data->pad[0] || data->pad[1] || data->pad[2] )
             break;
 
+	printk("ioreq_server_create\n");
         rc = ioreq_server_create(d, data->handle_bufioreq,
                                  &data->id);
         break;
